    <h1>Candidate Dashboard</h1>
    <div>
        <form action="/resume/upload" method="POST" enctype="multipart/form-data">
            <input type="file" name="resume" accept=".pdf,.doc,.docx">
            <button type="submit">Upload Resume</button>
        </form>
</body>
