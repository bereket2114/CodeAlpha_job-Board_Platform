<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Create a TaskFlow account and organize your daily tasks.">
  <title>Create account | TaskFlow</title>
  <link rel="shortcut icon" href="/favicon/taskflow-favicon.svg?v=2" type="image/svg+xml">
  <link rel="icon" href="/favicon/taskflow-favicon.svg?v=2" type="image/svg+xml">

  <meta name="theme-color" content="#6254e7">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/svg+xml" href="/taskflow-favicon.svg">
  <link rel="apple-touch-icon" href="/taskflow-favicon.svg">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    crossorigin="anonymous" referrerpolicy="no-referrer">
  <link rel="stylesheet" href="/auth.css">
</head>

<body class="auth-page">
  <header class="auth-header">
    <a class="brand" href="/" aria-label="job-board home"><img src="/job-board-logo.svg" alt="job-board"></a>
    <p>Already have an account? <a href="/register/login">Sign in</a></p>
  </header>

  <main class="auth-main">
    <section class="auth-card" aria-labelledby="page-title">
      <div class="card-icon"><i class="fa-solid fa-user-plus"></i></div>
      <p class="eyebrow">join us</p>
      <h1 id="page-title">Create your account</h1>
      <p class="intro">join our community and never miss an opportunity again.</p>

      <% if (locals.messages.errors) { %>
        <% messages.errors.forEach(el=> { %><div class="alert" role="alert"><i
              class="fa-solid fa-circle-exclamation"></i>
            <%= el.msg %>
          </div>
          <% }) %>
            <% } %>

              <form action="/register/signup" method="POST">
                <div class="field">
                  <label for="fullName">Full Name</label>
                  <input id="fullName" type="text"
                    name="fullName" placeholder="Enter your full name or if you are an employer, use your company name" autocomplete="name" required>
                  </div>
                <div class="field">
                  <label for="email">Email address</label>
                  <input id="email" type="email" name="email"
                    placeholder="you@example.com" autocomplete="email" required>
                </div>
                <div class="field">
                  <label for="phone">Phone Number</label>
                  <input id="phone" type="tel" name="phone"
                    placeholder="Enter your phone number" autocomplete="tel" required>
                </div>
                <div class="field">
                  <label for="password">Password</label>
                  <div class="password-field">
                    <input id="password" type="password" name="password"
                      placeholder="At least 8 characters" autocomplete="new-password" minlength="8" required>
                      <button
                      type="button" class="password-toggle" aria-label="Show password" aria-controls="password"><i
                        class="fa-solid fa-eye"></i>
                      </button>
                    </div>
                </div>
                <div class="field">
                  <label for="confirmPassword">Confirm password</label>
                  <div class="password-field">
                    <input id="confirmPassword" type="password" name="confirmPassword"
                      placeholder="Repeat your password" autocomplete="new-password" minlength="8" required>
                    <button
                      type="button" class="password-toggle" aria-label="Show password"
                      aria-controls="confirmPassword">
                      <i class="fa-solid fa-eye"></i>
                    </button>
                  </div>
                </div>
                <div class="field">
                <p>please select, which role you want to register as:</p>
                  <label for="role">Select Role</label>
                  <select id="role" name="role" required>
                    <option value="">--Please choose an option--</option>
                    <option name="role" value="candidate">candidate</option>
                    <option name="role" value="employer">employer</option>
                  </select>
                </div>
                <button class="submit-button" type="submit">Create account 
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
              </form>
              
              <p class="mobile-switch">Already have an account? 
                <a href="/register/login">Sign in</a>
              </p>
    </section>
  </main>
  <footer>job-board · Find your dream job today.</footer>

  <script src="/password-visibility.js"></script>
</body>

</html>